{
  "name": "diff-compare",
  "displayName": "Diff Compare",
  "description": "在 VS Code 标签页里做双栏对比：比较文本、十六进制与二进制文件，对比整个目录，并按差异逐处或整体同步。",
  "version": "0.1.3",
  "publisher": "Aurumjin",
  "license": "GPL-3.0-or-later",
  "icon": "media/icon.png",
  "homepage": "https://github.com/Aujin/diff-compare",
  "repository": {
    "type": "git",
    "url": "https://github.com/Aujin/diff-compare.git"
  },
  "bugs": {
    "url": "https://github.com/Aujin/diff-compare/issues"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "diff",
    "compare",
    "directory compare",
    "hex",
    "binary"
  ],
  "galleryBanner": {
    "color": "#1F2430",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "contributes": {
    "commands": [
      {
        "command": "diffCompare.open",
        "title": "%cmd.open%",
        "category": "Diff Compare",
        "icon": "media/diff-compare.svg"
      },
      {
        "command": "diffCompare.newPanel",
        "title": "%cmd.newPanel%",
        "category": "Diff Compare",
        "icon": "media/diff-compare.svg"
      },
      {
        "command": "diffCompare.addFromContext",
        "title": "%cmd.addFromContext%",
        "category": "Diff Compare"
      },
      {
        "command": "diffCompare.addWorkspaceFolder",
        "title": "%cmd.addWorkspaceFolder%",
        "category": "Diff Compare"
      },
      {
        "command": "diffCompare.pickTarget",
        "title": "%cmd.pickTarget%",
        "category": "Diff Compare"
      },
      {
        "command": "diffCompare.swap",
        "title": "%cmd.swap%",
        "category": "Diff Compare"
      },
      {
        "command": "diffCompare.clear",
        "title": "%cmd.clear%",
        "category": "Diff Compare"
      },
      {
        "command": "diffCompare.addActiveToLeft",
        "title": "%cmd.addActiveToLeft%",
        "category": "Diff Compare"
      },
      {
        "command": "diffCompare.addActiveToRight",
        "title": "%cmd.addActiveToRight%",
        "category": "Diff Compare"
      },
      {
        "command": "diffCompare.syncAllToLeft",
        "title": "%cmd.syncAllToLeft%",
        "category": "Diff Compare"
      },
      {
        "command": "diffCompare.syncAllToRight",
        "title": "%cmd.syncAllToRight%",
        "category": "Diff Compare"
      },
      {
        "command": "diffCompare.find",
        "title": "%cmd.find%",
        "category": "Diff Compare"
      },
      {
        "command": "diffCompare.undo",
        "title": "%cmd.undo%",
        "category": "Diff Compare"
      },
      {
        "command": "diffCompare.showLogs",
        "title": "%cmd.showLogs%",
        "category": "Diff Compare"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "diffCompare.newPanel",
          "group": "navigation",
          "when": "editorIsOpen"
        }
      ],
      "editor/title/context": [
        {
          "command": "diffCompare.addFromContext",
          "group": "1_diffCompare",
          "when": "resourceScheme == file"
        }
      ],
      "explorer/context": [
        {
          "command": "diffCompare.addFromContext",
          "group": "1_diffCompare"
        }
      ],
      "commandPalette": [
        {
          "command": "diffCompare.addFromContext",
          "when": "false"
        },
        {
          "command": "diffCompare.open",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "diffCompare.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "diffCompare.focused"
      }
    ],
    "configuration": {
      "title": "Diff Compare",
      "properties": {
        "diffCompare.allowOutsideWorkspace": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.allowOutsideWorkspace%"
        },
        "diffCompare.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/.hg/**",
            "**/.svn/**"
          ],
          "markdownDescription": "%config.exclude%"
        },
        "diffCompare.maxFileSize": {
          "type": "number",
          "default": 32,
          "markdownDescription": "%config.maxFileSize%"
        },
        "diffCompare.defaultViewMode": {
          "type": "string",
          "enum": [
            "auto",
            "text",
            "hex",
            "binary"
          ],
          "enumDescriptions": [
            "%config.mode.auto%",
            "%config.mode.text%",
            "%config.mode.hex%",
            "%config.mode.binary%"
          ],
          "default": "auto",
          "description": "%config.defaultViewMode%"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "node build.mjs --noEmit",
    "test": "node build.mjs && node tools/selftest.mjs && node tools/check-protocol.mjs && node tools/host-harness.mjs && node tools/webview-harness.mjs",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "vscode:prepublish": "npm run build",
    "icon": "node tools/make-icon.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/vscode": "^1.84.0",
    "@vscode/vsce": "^4.1.1",
    "jsdom": "^31.0.1",
    "typescript": "^5.7.3"
  }
}
